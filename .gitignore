# Ansible runtime output
reports/**/*.json
reports/**/*.log
reports/**/*.md
reports/incidents/

# Ansible retry files
*.retry

# Local-only overrides / secrets
*.local.yml
*.secret.yml
*vault*.yml

# Python / tooling
__pycache__/
*.pyc

# Editor / OS
.vscode/
.DS_Store

# Temporary files
*.tmp

# vault
*.bak
*.plain
*.decrypted
.vault_pass
homelab_vault_pass

# TLS certificates, keys, and CSRs
*.crt
*.key
*.csr
*.pem

# CA source files (誤ってリポジトリ内に配置された場合の保護)
# 実際の /home/yoshi/.cert はリポジトリ外であり、ファイル権限(0600)で保護する
.cert/

# ヘルパーシェル(ローカル専用の使い捨てスクリプト置き場。除外しないものは個別に
# 打ち消す — いずれもリポジトリに残す成果物である)
#   scripts/tests/fixtures/                  scripts/check-doc-consistency.py の回帰fixture
#   scripts/tests/operator_request_channel/  Operator Request Channelのoffline/integration test
#   scripts/tests/semaphore_schedules/       semaphore_schedules filter pluginの単体test
#   scripts/tests/oprc_submit/               scripts/oprc-submit.sh の回帰test
scripts/tests/*
!scripts/tests/fixtures/
!scripts/tests/operator_request_channel/
!scripts/tests/semaphore_schedules/
!scripts/tests/oprc_submit/
new-session.sh*
kick.sh
prep-agent.sh*
start-tester.sh
stop-tester.sh
swap-right.sh

tmux-ask-watch.sh


.codex
.claude/settings.local.json

# テスト出力（ローカル。スクショ等を含むため public リポジトリに入れない）
test-output/
