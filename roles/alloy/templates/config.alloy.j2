// Managed by Ansible (roles/alloy). Do not edit on the host.
// Phase 2 preserves the existing UniFi contract, adds remote syslog files,
// and normalizes severity to error|warning|info|debug. Optional new files are
// discovered without constructing a reader until they exist.

loki.write "local" {
  endpoint {
    url = {{ alloy_loki_push_url | to_json }}
  }
}

{% for source in alloy_file_sources %}
{% set needs_pipeline = (source.extract_second_token_as_host | default(false) | bool) or (source.extract_normalized_level_at_start | default(false) | bool) or (source.strip_normalized_prefix | default(false) | bool) or (source.extract_level_best_effort | default(false) | bool) %}
{% if needs_pipeline %}
loki.process {{ (source.name ~ '_pipeline') | to_json }} {
  forward_to = [loki.write.local.receiver]

{% if source.extract_normalized_level_at_start | default(false) | bool %}
  stage.regex {
    expression = "^(?P<level>error|warning|info|debug)\\s"
  }

  stage.labels {
    values = {
      "level" = "level",
    }
  }

{% endif %}
{% if source.extract_second_token_as_host | default(false) | bool %}
  stage.regex {
    expression = "^\\S+ (?P<host>\\S+) "
  }

  stage.labels {
    values = {
      "host" = "host",
    }
  }

{% endif %}
{% if source.strip_normalized_prefix | default(false) | bool %}
  // The receiver writes: <level> <host> <RFC3339 timestamp> <message>.
  // level/host are labels by this point, so retain only the message in Loki.
  stage.regex {
    expression = "^(?:error|warning|info|debug)\\s+\\S+\\s+\\S+\\s+(?P<message>.*)$"
  }

  stage.output {
    source = "message"
  }

{% endif %}
{% if source.extract_level_best_effort | default(false) | bool %}
{% set selector_prefix = '{job=' ~ (source.labels.job | to_json) ~ '} |~ ' %}
{% set selector_token_prefix = '(?i)^(?:\\\\S+\\\\s+){0,3}' %}
  // Existing UniFi formats are heterogeneous. Only treat an explicit
  // severity token near the beginning as authoritative; otherwise omit level.
  stage.match {
    selector = {{ (selector_prefix ~ '"' ~ selector_token_prefix ~ '(?:emerg|alert|crit|err|error)(?:\\\\s|:)"') | to_json }}

    stage.static_labels {
      values = { "level" = "error" }
    }
  }

  stage.match {
    selector = {{ (selector_prefix ~ '"' ~ selector_token_prefix ~ '(?:warn|warning)(?:\\\\s|:)"') | to_json }}

    stage.static_labels {
      values = { "level" = "warning" }
    }
  }

  stage.match {
    selector = {{ (selector_prefix ~ '"' ~ selector_token_prefix ~ '(?:notice|info)(?:\\\\s|:)"') | to_json }}

    stage.static_labels {
      values = { "level" = "info" }
    }
  }

  stage.match {
    selector = {{ (selector_prefix ~ '"' ~ selector_token_prefix ~ 'debug(?:\\\\s|:)"') | to_json }}

    stage.static_labels {
      values = { "level" = "debug" }
    }
  }
{% endif %}
{% if source.labels.job == 'unifi' %}
{% set cef_selector_prefix = '{job=' ~ (source.labels.job | to_json) ~ '} |~ ' %}
{% set cef_header_prefix = 'CEF:[[:space:]]*[0-9]+\\\\|[^|]*\\\\|[^|]*\\\\|[^|]*\\\\|[^|]*\\\\|[^|]*\\\\|' %}
{% set cef_regex_delimiter = '"' %}
  // CloudKey's two CEF producers differ only in optional whitespace after
  // "CEF:". Treat the numeric CEF header severity as authoritative, after
  // the generic token-based best-effort stages above. Labels only: preserve
  // both UniFi raw message formats byte-for-byte.
  stage.match {
    selector = {{ (cef_selector_prefix ~ cef_regex_delimiter ~ cef_header_prefix ~ '[0-3]\\\\|' ~ cef_regex_delimiter) | to_json }}

    stage.static_labels {
      values = { "level" = "info" }
    }
  }

  stage.match {
    selector = {{ (cef_selector_prefix ~ cef_regex_delimiter ~ cef_header_prefix ~ '[4-6]\\\\|' ~ cef_regex_delimiter) | to_json }}

    stage.static_labels {
      values = { "level" = "warning" }
    }
  }

  stage.match {
    selector = {{ (cef_selector_prefix ~ cef_regex_delimiter ~ cef_header_prefix ~ '(?:10|[7-9])\\\\|' ~ cef_regex_delimiter) | to_json }}

    stage.static_labels {
      values = { "level" = "error" }
    }
  }
{% endif %}
}

{% endif %}
loki.source.file {{ source.name | to_json }} {
  targets = [
    {
      "__path__" = {{ source.path | to_json }},
{% for label in source.labels | dictsort %}
      {{ label.0 | to_json }} = {{ label.1 | to_json }},
{% endfor %}
    },
  ]
  tail_from_end = {{ source.tail_from_end | bool | lower }}
  file_match {
    enabled     = true
    sync_period = "10s"
  }
{% if needs_pipeline %}
  forward_to = [loki.process.{{ source.name }}_pipeline.receiver]
{% else %}
  forward_to = [loki.write.local.receiver]
{% endif %}
}

{% endfor %}
{% for source in alloy_journal_sources %}
loki.relabel {{ (source.name ~ '_metadata') | to_json }} {
  forward_to = []

  rule {
    source_labels = [{{ source.source_unit_label | to_json }}]
    target_label  = {{ source.target_unit_label | to_json }}
  }

  rule {
    source_labels = [{{ source.source_priority_label | to_json }}]
    regex         = "[0-3]"
    target_label  = "level"
    replacement  = "error"
  }

  rule {
    source_labels = [{{ source.source_priority_label | to_json }}]
    regex         = "4"
    target_label  = "level"
    replacement  = "warning"
  }

  rule {
    source_labels = [{{ source.source_priority_label | to_json }}]
    regex         = "[5-6]"
    target_label  = "level"
    replacement  = "info"
  }

  rule {
    source_labels = [{{ source.source_priority_label | to_json }}]
    regex         = "7"
    target_label  = "level"
    replacement  = "debug"
  }
}

{% set drop_info_debug_units = source.drop_info_debug_units | default([]) %}
{% if drop_info_debug_units | length > 0 %}
loki.process {{ (source.name ~ '_pipeline') | to_json }} {
  forward_to = [loki.write.local.receiver]

{% for unit in drop_info_debug_units %}
{% set drop_selector = '{job=' ~ (source.labels.job | to_json) ~ ', host=' ~ (source.labels.host | to_json) ~ ', unit=' ~ (unit | to_json) ~ ', level=~"info|debug"}' %}
  stage.match {
    selector            = {{ drop_selector | to_json }}
    action              = "drop"
    drop_counter_reason = "observability_info_debug"
  }

{% endfor %}
}

{% endif %}
loki.source.journal {{ source.name | to_json }} {
  max_age       = {{ source.max_age | to_json }}
  relabel_rules = loki.relabel.{{ source.name }}_metadata.rules
  labels = {
{% for label in source.labels | dictsort %}
    {{ label.0 | to_json }} = {{ label.1 | to_json }},
{% endfor %}
  }
{% if drop_info_debug_units | length > 0 %}
  forward_to = [loki.process.{{ source.name }}_pipeline.receiver]
{% else %}
  forward_to = [loki.write.local.receiver]
{% endif %}
}

{% endfor %}
