{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "infra-syslog-all-nodes-v1",
    "namespace": "default",
    "uid": "infra-syslog-all-nodes-v1"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Event Timeline",
          "description": "Event count per host. Series A covers Ubuntu / PVE / Sophos / CloudKey and honours the Severity filter. Series B covers UniFi network devices, which carry no level label (LOG-075) and are therefore not filtered by Severity.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "ffn86ietu7jeoc"
                      },
                      "spec": {
                        "expr": "sum by(host) (count_over_time({job=~\"pve-nodes|sophos-fw|ubuntu-nodes|unifi\", host=~\"$host\", level=~\"$level\"} |= \"$search\" [$__interval]))",
                        "legendFormat": "{{host}}",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "ffn86ietu7jeoc"
                      },
                      "spec": {
                        "expr": "sum by(host) (count_over_time({job=\"network-devices\", host=~\"$host\"} |= \"$search\" [$__interval]))",
                        "legendFormat": "{{host}}",
                        "queryType": "range"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "custom": {
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "bars",
                    "fillOpacity": 70,
                    "lineWidth": 0
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Infra Events (Ubuntu / PVE / Sophos/uckg2)",
          "description": "Unified log stream for monnie, ansy, quory, authy, pve1, pve2, sophos-fw and the CloudKey (uckg2). All of these carry a level label, so the Severity filter applies. UniFi network devices are in the separate panel below.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "ffn86ietu7jeoc"
                      },
                      "spec": {
                        "expr": "{job=~\"pve-nodes|sophos-fw|ubuntu-nodes|unifi\", host=~\"$host\", level=~\"$level\"} |= \"$search\" | line_format \"{{ .host }} | {{ __line__ }}\"",
                        "maxLines": 1500,
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": false
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Network Device Events (UniFi switches / APs)",
          "description": "Log stream for UniFi network devices. These lines carry no level label (LOG-075), so the Severity filter does not apply here by design. Use Host and Keyword to narrow, for example TRAPMGR for Link Up and Link Down.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "ffn86ietu7jeoc"
                      },
                      "spec": {
                        "expr": "{job=\"network-devices\", host=~\"$host\"} |= \"$search\" | line_format \"{{ .host }} | {{ __line__ }}\"",
                        "maxLines": 1500,
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": false
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 6,
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 6,
              "width": 24,
              "height": 20,
              "element": {
                "kind": "ElementReference",
                "name": "panel-2"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 26,
              "width": 24,
              "height": 14,
              "element": {
                "kind": "ElementReference",
                "name": "panel-3"
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "infrastructure",
      "loki",
      "syslog",
      "ubuntu",
      "pve",
      "sophos"
    ],
    "timeSettings": {
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Infra Syslog (All Nodes)",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "host",
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "label": "Host",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "ffn86ietu7jeoc"
            },
            "spec": {
              "__legacyStringValue": "label_values({job=~\"pve-nodes|sophos-fw|ubuntu-nodes|unifi|network-devices\"}, host)"
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allValue": ".+",
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "level",
          "current": {
            "text": [
              "warning",
              "error"
            ],
            "value": [
              "warning",
              "error"
            ]
          },
          "label": "Severity",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "ffn86ietu7jeoc"
            },
            "spec": {
              "__legacyStringValue": "label_values({job=~\"pve-nodes|sophos-fw|ubuntu-nodes|unifi|network-devices\"}, level)"
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allValue": ".+",
          "allowCustomValue": true
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "search",
          "current": {
            "text": "",
            "value": ""
          },
          "query": "",
          "label": "🔍 Keyword",
          "hide": "dontHide",
          "skipUrlSync": false
        }
      }
    ]
  }
}
