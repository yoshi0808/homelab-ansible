#!/bin/bash
# codex-investigate-wrapper: invoked by {{ incident_inspect_caller_user }} via sudo
# (sudoers-incident-inspect.j2: "{{ incident_inspect_caller_user }} ALL =
# ({{ incident_inspect_user }}) NOPASSWD: {{ incident_inspect_codex_wrapper }}").
# Strictly validates args, then injects fixed sandbox/approval flags and
# executes Codex as {{ incident_inspect_user }}. Modeled on
# roles/recovery_exec/templates/codex-exec-wrapper.j2.
#
# Authentication: Codex uses browser OAuth; the token is in ~/.codex/ (no API
# key). Callers must invoke this via `sudo -H -u {{ incident_inspect_user }}`
# so HOME resolves to {{ incident_inspect_home }} and Codex finds its token
# and config (same convention as recovery-io.py's `sudo -H -u recovery-exec`).
#
# Security:
#   - This file: mode 0500 owned by {{ incident_inspect_user }} (the caller,
#     {{ incident_inspect_caller_user }}, cannot read it — only execute it via
#     sudo, which switches the effective user before the exec-permission check)
#   - Accepts ONLY: exec --cd <workspace> <message>  (exactly 4 args, no more)
#   - Caller cannot influence sandbox / approval / execpolicy flags
#   - `--sandbox read-only` is hardcoded here, not read from config or the
#     caller: this is the actual enforcement of "the LLM gets no write
#     capability" (R6/IC-035), not the [sandbox_workspace_write] table in
#     config.toml (documentation only — see that file's comment)
set -euo pipefail

WORKSPACE="{{ incident_inspect_workspace }}"

if [[ "${1:-}" != "exec" ]]; then
    echo "denied: first argument must be 'exec'" >&2
    exit 1
fi
if [[ "${2:-}" != "--cd" ]]; then
    echo "denied: second argument must be '--cd'" >&2
    exit 1
fi
if [[ "${3:-}" != "$WORKSPACE" ]]; then
    echo "denied: workspace path must be '$WORKSPACE'" >&2
    exit 1
fi
if [[ $# -ne 4 ]]; then
    echo "denied: exactly 4 arguments required (exec --cd <workspace> <message>)" >&2
    exit 1
fi

message="${4}"

exec "{{ incident_inspect_codex_bin }}" exec \
    --skip-git-repo-check \
    --sandbox read-only \
    -c 'approval_policy="never"' \
    -c 'sandbox_workspace_write.network_access=false' \
    --cd "$WORKSPACE" \
    "$message"
