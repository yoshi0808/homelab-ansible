[Unit]
Description=Homelab incident primary investigation (per-job, quory, U2)
Documentation=file://{{ incident_investigate_repo_dir }}/docs/ai/adr/009-per-incident-investigation-runtime.md
After=network.target

[Service]
Type=oneshot
User={{ incident_investigate_run_user }}
Environment=INCIDENT_INVESTIGATE_CONFIG={{ incident_investigate_config_path }}
# 多重起動抑止(AC7・IC-039)。incident-capture.service の前例に倣い、通常の
# 失敗(exit 1)と区別できる終了コードを明示する。
ExecStart=/usr/bin/flock -n -E 75 {{ incident_investigate_lock_path }} /usr/bin/python3 {{ incident_investigate_script_path }}
# 1回の起動で処理する候補バンドルは最大1件(T4。incident-investigate.py の
# main() 参照)。llm_timeout_s(既定300)+ I/Oのゆとりとして420秒とした。
TimeoutStartSec={{ incident_investigate_timeout_start_sec }}
# 2026-07-31差し戻し(独立レビュー Suggestion #3)。SuccessExitStatus=75 が
# 無いと、flockが多重起動を弾いた正常なskip(exit 75)と、
# incident-investigate.py自身が調査失敗を報告した場合(exit 2)の両方が
# systemdの`failed`として同じ外形になり、AC6が要求する「failedは調査の
# 失敗を意味する」が成立しない。75を成功終了コードに追加することで、
# skip時は`inactive`(is-failedはfailedを返さない)、調査失敗時(exit 2)・
# 内部例外(exit 3)は引き続き`failed`になる(実測: systemd-run --user で
# SuccessExitStatus=75の有無による is-failed の違いを確認済み — 詳細は
# 2026-07-31_005_u2_implement.md)。roles/incident_capture の同型ユニットは
# 意図的に変更していない(差し戻し指示どおり)。
SuccessExitStatus=75
