[Unit]
Description=Hourly incident bundle mirror sync (pull from quory)
Documentation=file://{{ incident_sync_repo_dir }}/docs/ai/reviews/incident_auto_capture_step2/2026-07-28_007_step2_plan.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ incident_sync_run_user }}
WorkingDirectory={{ incident_sync_repo_dir }}
# 排他は入れ子flock(査読F-6、計画§2.2)。ExecStartの中に2つのflock呼び出しを
# ネストし、月次Knowledge振り返りと同期を構造的に排他する。
#
#   外側 = 月次振り返り(ansible-knowledge-review.service)と共有するロック。
#          `-E 0` は「衝突は失敗ではない」ことを表す(計画§2.2) — 月次評価が
#          ミラーを読んでいる最中は、このExecStart全体が exit 0 で静かに
#          スキップされる(systemd上もfailedを報告しない)。次周期(最大1時間後)
#          で自然に埋まる(IC-012)。R-11のとおり、毎月1回・最大1周期のスキップは
#          異常として鳴らさない意図的な設計である。
#   内側 = incident_sync 自身の多重起動防止。knowledge-review.service の
#          `flock -n`(既定exit 1)と同じ扱いで、-E は明示しない — 同一timerの
#          多重起動はsystemd自体が抑止するため、ここで衝突するのは手動の
#          同時実行程度であり、区別が必要なほどの頻度・実害ではない。
#
# 内側flockが実行するのは ansible-playbook そのもの(quoryへの実転送はここが
# 起点)。転送そのものの--check挙動はplaybooks/incident_sync.ymlのtester-gate
# コメントと roles/incident_sync/tasks/transfer.yml を参照。
TimeoutStartSec={{ incident_sync_timeout_start_sec }}
ExecStart=/usr/bin/flock -n -E 0 {{ incident_sync_outer_lock_path }} /usr/bin/flock -n {{ incident_sync_lock_path }} {{ incident_sync_playbook_bin }} playbooks/incident_sync.yml
