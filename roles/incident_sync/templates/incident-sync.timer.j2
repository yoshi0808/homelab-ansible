[Unit]
Description=Hourly incident bundle mirror sync (timer)

[Timer]
OnCalendar={{ incident_sync_schedule }}
# ansyが停止していて発火を逃しても、IC-012(転送の停止は遅延にしかならない)を
# 保つため取り戻す。転送は冪等・差分埋めなので、復旧後の1回で取りこぼしに追いつく
# (knowledge-review.timer と同じ理由。ただしこちらは毎時なので取り戻す幅は
# 最大でも1周期分)。
Persistent=true

[Install]
WantedBy=timers.target
