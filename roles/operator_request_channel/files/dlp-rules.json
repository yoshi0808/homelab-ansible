{
  "engine_version": "1",
  "ruleset_version": "2026-08-08.1",
  "rules": [
    {
      "id": "pem-or-ssh-private-key",
      "category": "pem_private_key",
      "pattern": "-----BEGIN ((RSA|EC|DSA|OPENSSH|ENCRYPTED) )?PRIVATE KEY-----"
    },
    {
      "id": "slack-token",
      "category": "slack_credential",
      "pattern": "xox[baprs]-[0-9A-Za-z-]{10,}"
    },
    {
      "id": "slack-webhook-url",
      "category": "slack_credential",
      "pattern": "https://hooks\\.slack\\.com/services/[A-Za-z0-9]+/[A-Za-z0-9]+/[A-Za-z0-9]+"
    },
    {
      "id": "semaphore-api-token",
      "category": "semaphore_api_token",
      "pattern": "(?i)semaphore[_-]?(api[_-]?)?(token|key)[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9_-]{16,}"
    },
    {
      "id": "bearer-token",
      "category": "bearer_or_jwt",
      "pattern": "(?i)\\bbearer\\s+[A-Za-z0-9\\-_.]{10,}"
    },
    {
      "id": "jwt",
      "category": "bearer_or_jwt",
      "pattern": "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+"
    },
    {
      "id": "generic-secret-keyvalue",
      "category": "generic_secret_keyvalue",
      "pattern": "(?i)\\b(password|passwd|pwd|secret|token|api[_-]?key|apikey|access[_-]?key)\\b\\s*[:=]\\s*[\"']?[^\\s\"']{4,}"
    },
    {
      "id": "vault-decrypted-plaintext",
      "category": "vault_plaintext",
      "pattern": "(?i)\\bvault_[a-z0-9_]*\\s*[:=]\\s*\\S+"
    },
    {
      "id": "credential-in-url",
      "category": "credential_url",
      "pattern": "[a-zA-Z][a-zA-Z0-9+.-]*://[^/\\s:@]+:[^/\\s@]+@[^\\s]+"
    },
    {
      "id": "env-dump",
      "category": "env_dump",
      "pattern": "(?:(?:^|\\n)[A-Z][A-Z0-9_]{2,}=[^\\n]*){3,}"
    },
    {
      "id": "proc-environ",
      "category": "proc_environ",
      "pattern": "/proc/(?:self|[0-9]+)/environ"
    },
    {
      "id": "private-ipv4",
      "category": "private_ipv4",
      "pattern": "(?<![0-9.])(10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}|172\\.(?:1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.[0-9]{1,3}|192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3})(?![0-9.])"
    },
    {
      "id": "ipv6-ula-or-link-local",
      "category": "ipv6_ula_link_local",
      "pattern": "(?i)\\b(f[cd][0-9a-f]{2}|fe80):[0-9a-f:]*\\b"
    }
  ],
  "entropy": {
    "id": "high-entropy-string",
    "category": "high_entropy",
    "min_length": 20,
    "min_bits_per_char": 3.8,
    "candidate_pattern": "[A-Za-z0-9+/_=.-]{20,}",
    "scan_field_pointers": [
      "/purpose",
      "/observed_facts/*",
      "/requested_information",
      "/expected_result",
      "/unconfirmed/*"
    ]
  }
}
