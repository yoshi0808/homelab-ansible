[Unit]
Description=Homelab Recovery I/O (Slack listener)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ recovery_io_user }}
Group={{ recovery_io_user }}
ExecStart={{ recovery_io_install_dir }}/venv/bin/python {{ recovery_io_script }}
EnvironmentFile={{ recovery_io_env_dir }}/recovery-io.env
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening (§7)
# NoNewPrivileges left unset (default=no) — recovery-io must call sudo.
PrivateTmp=yes
ProtectSystem=strict
# read-only + ReadWritePaths: Codex (child process via sudo) needs to write
# to ~/.codex/ for its in-process app-server state. DAC (0700 recovery-exec)
# still prevents recovery-io user from accessing those files.
# /var/lib/homelab-recovery/mute is also listed: this unit's ProtectSystem=strict
# mount namespace is the one Codex's own bwrap sandbox binds writable roots
# from, so even with sandbox_workspace_write.writable_roots set in
# codex-config.toml.j2 (§ mute wrapper), a Slack-triggered mute set/clear
# under this service would still hit a read-only filesystem without also
# opening it here (test_result 2026-07-14_012 T1).
ProtectHome=read-only
ReadWritePaths={{ recovery_io_exec_home }} {{ recovery_io_exec_workspace }} /var/lib/homelab-recovery/mute
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
