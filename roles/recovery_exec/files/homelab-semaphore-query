#!/usr/bin/env bash
# homelab-semaphore-query: read-only Semaphore failed-task lookup (SQLite).
#
# Codex selects a fixed query name plus an integer parameter only. The SQL
# text is fixed in this script and never built from caller-supplied strings.
# The finished SQL is passed to sqlite3 as a single argv element via exec
# (no shell string concatenation / no `sh -c`), so shell metacharacters in
# an argument can never be reinterpreted (same lesson as the Sophos expect
# script: build the argv array in-process, don't hand a string to a shell).
#
# No sudo: Codex invokes this wrapper inside a sandbox with no_new_privileges
# set, which blocks sudo unconditionally regardless of sudoers config
# (confirmed via a live failure: "sudo: The 'no new privileges' flag is
# set..."). Instead, recovery-exec gets a POSIX ACL grant (traverse on
# /var/lib/semaphore, read on semaphore.db — see
# roles/recovery_exec/tasks/main.yml) for direct, non-elevated read access.
# semaphore.db uses journal_mode=delete (confirmed, not WAL), so there are
# no -wal/-shm companion files to also grant.
set -euo pipefail

DB=/var/lib/semaphore/semaphore.db
SQLITE=/usr/bin/sqlite3

usage() {
  echo "usage: homelab-semaphore-query <recent-failed <n>|running <n>|task-errors <id>|task-hosts <id>|task-output <id>|task-time <id>|template-list <n>>" >&2
  exit 1
}

is_uint() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

query="${1:-}"
param="${2:-}"

case "$query" in
  recent-failed)
    is_uint "$param" || usage
    # 10# forces base-10 so a leading zero (e.g. "008") isn't read as octal.
    if (( 10#$param < 1 || 10#$param > 200 )); then
      echo "denied: n out of range (1-200)" >&2
      exit 1
    fi
    sql="SELECT t.id, tpl.name AS template, tpl.playbook, t.status, substr(t.start,1,19) AS start FROM task t LEFT JOIN project__template tpl ON t.template_id = tpl.id WHERE t.status IN ('error','stopped') ORDER BY t.id DESC LIMIT ${param};"
    ;;
  running)
    is_uint "$param" || usage
    # 10# forces base-10 (same reason as recent-failed).
    if (( 10#$param < 1 || 10#$param > 200 )); then
      echo "denied: n out of range (1-200)" >&2
      exit 1
    fi
    # 「実行中」を status の肯定的な列挙で書かない。Semaphore が実行中を表す
    # 値(waiting / starting / running 等)はこの環境で観測されておらず、
    # 列挙すると観測漏れがそのまま「動いていない」という誤答になる。終端3値
    # (success / error / stopped)は実測済み(docs/ai/context/system/
    # semaphore.md)なので、「終端でないものを実行中とみなす」向きに倒す。
    # 未知の値が現れたら安全側(実行中とみなす側)へ落ちる。
    #
    # start は substr で19文字に切っていない。recent-failed が切り落として
    # いる末尾のゾーン表記こそ、保存形式(Go の time.Time.String())を判断
    # する材料になるため(task-time と同じ理由)。
    sql="SELECT t.id, tpl.name AS template, tpl.playbook, t.status, t.start FROM task t LEFT JOIN project__template tpl ON t.template_id = tpl.id WHERE t.status NOT IN ('success','error','stopped') ORDER BY t.id DESC LIMIT ${param};"
    ;;
  task-errors)
    is_uint "$param" || usage
    sql="SELECT task, host, substr(error,1,500) AS error_head FROM task__ansible_error WHERE task_id = ${param};"
    ;;
  task-hosts)
    is_uint "$param" || usage
    sql="SELECT * FROM task__ansible_host WHERE task_id = ${param};"
    ;;
  task-output)
    is_uint "$param" || usage
    sql="SELECT time, output FROM task__output WHERE task_id = ${param} ORDER BY time;"
    ;;
  task-time)
    is_uint "$param" || usage
    # Unlike recent-failed, start/end are NOT substr()-truncated here: the
    # point of this query is to see whatever suffix (Z / +09:00 / none)
    # Semaphore actually persisted, which substr(...,1,19) would strip.
    # `end` is quoted as [end] because it is a SQL keyword (CASE/TRIGGER);
    # unquoted it fails to parse as a column reference in SQLite.
    sql="SELECT t.id, tpl.name AS template, tpl.playbook, t.status, t.start, t.[end] FROM task t LEFT JOIN project__template tpl ON t.template_id = tpl.id WHERE t.id = ${param};"
    ;;
  template-list)
    is_uint "$param" || usage
    # 10# forces base-10 (same reason as recent-failed).
    if (( 10#$param < 1 || 10#$param > 200 )); then
      echo "denied: n out of range (1-200)" >&2
      exit 1
    fi
    # 「本番で押せるボタン」の一覧。テンプレートはSemaphoreのUIで手作りされて
    # おりrepoに正本が無いため、設計の入力をここから取る(2026-08-04)。
    #
    # 2文を返す。1文目は project__template の CREATE TABLE 文そのもの、2文目が
    # 行の中身である。**列名を推測しないため**にこの形にしている — 既存クエリが
    # 使っている id / name / playbook は実在が確定しているが、引数の有無を表す
    # 列(arguments 等)がこのバージョンに存在するか、名前が何かは未確認である。
    # スキーマ本文と `SELECT *` を並べれば、列の並び順で対応がとれて1回の配備で
    # 済む(推測して外すと再配備が要り、そのたびに人のRunを1回消費する)。
    #
    # この表を選ぶのは、押せるボタンの定義がここにあるからである。秘密は
    # access_key(暗号化)と project__environment 側にあり、いずれもこの
    # スクリプトの対象ではない。`SELECT *` は task-hosts と同じ流儀。
    sql="SELECT sql FROM sqlite_master WHERE type='table' AND name='project__template'; SELECT * FROM project__template ORDER BY id LIMIT ${param};"
    ;;
  *)
    usage
    ;;
esac

exec "$SQLITE" -readonly "$DB" "$sql"
