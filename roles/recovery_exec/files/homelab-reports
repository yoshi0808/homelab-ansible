#!/usr/bin/env bash
# homelab-reports: Codex-facing wrapper for read-only reports/ JSON lookup.
#
# reports/ lives under /home/yoshi, owned by yoshi. recovery-exec is not in
# yoshi's group, so a POSIX ACL grants it direct traverse (x) on /home/yoshi
# (see roles/recovery_exec/tasks/main.yml); reports/ and its files are
# already world-readable below that point. No sudo/setuid elevation is used:
# Codex invokes this wrapper inside a sandbox with no_new_privileges set,
# which unconditionally blocks sudo regardless of sudoers config (confirmed
# via a live Slack investigation run that failed with "sudo: The 'no new
# privileges' flag is set..."). ACL-based direct read has no such problem
# because it grants recovery-exec's own UID a permission bit rather than
# escalating to another identity.
#
# This wrapper validates arguments, then calls the privileged-format helper
# directly (no user switch); the helper re-validates everything
# independently before touching the filesystem (§4.4: no single layer is
# trusted blindly; no eval/variable expansion of unvalidated input).
set -euo pipefail

NAME_RE='^[a-zA-Z0-9_-]+$'
FILE_RE='^[a-zA-Z0-9_-]+\.json$'

usage() {
  echo "usage: homelab-reports <list-playbooks|list-reports <playbook> [target]|show-report <playbook> [target] <filename>>" >&2
  exit 1
}

# [target] is one optional extra path segment for nested report layouts
# (e.g. reports/recovery_investigations/<target>/*.json). Most playbooks are
# flat and never use it.
case "${1:-}" in
  list-playbooks)
    [[ $# -eq 1 ]] || usage
    ;;
  list-reports)
    case $# in
      2) [[ "$2" =~ $NAME_RE ]] || usage ;;
      3) [[ "$2" =~ $NAME_RE && "$3" =~ $NAME_RE ]] || usage ;;
      *) usage ;;
    esac
    ;;
  show-report)
    case $# in
      3) [[ "$2" =~ $NAME_RE && "$3" =~ $FILE_RE ]] || usage ;;
      4) [[ "$2" =~ $NAME_RE && "$3" =~ $NAME_RE && "$4" =~ $FILE_RE ]] || usage ;;
      *) usage ;;
    esac
    ;;
  *)
    usage
    ;;
esac

exec /usr/local/sbin/recovery-reports-helper "$@"
