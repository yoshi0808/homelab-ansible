#!/bin/bash
# homelab-investigate-{{ target.name }}: SSH investigation wrapper for {{ target.name }} (Proxmox node).
# Called by Codex: homelab-investigate-{{ target.name }} <check> [<param1> [<param2>]]
# Hostname is hardcoded (connection target fixed in script, not from args).
# -F /dev/null: skip system ssh_config (bwrap UID mapping breaks ownership checks).
#
# Read-only only: cluster / HA / replication / storage / ZFS / journal status.
# pve1/pve2 have no recovery action wrappers (see AGENTS.md /
# autonomous_recovery_policy.md §4.6). Parameterized Phase 2 checks are
# validated here for fast feedback and independently revalidated by the pve
# forced-command dispatch, which is the actual authorization boundary.
set -euo pipefail

KEY=/home/recovery-exec/.ssh/id_recovery_investigate_pve
KNOWN=/home/recovery-exec/.ssh/known_hosts

# Allowlist and validators mirror the dispatch script on {{ target.name }}.
# This wrapper is a first-line filter, not the sole gate. Only validated
# operands are formatted into SSH's required single remote-command string;
# the pve dispatch never evals that string and builds sudo argv positionally.
check="${1:-}"
p1="${2:-}"
p2="${3:-}"
argc=$#

if (( argc > 3 )); then
  echo "denied: too many parameters for '${check:-unknown}'" >&2
  exit 1
fi

deny_count() {
  echo "denied: invalid parameter count for '$check'" >&2
  exit 1
}

deny_invalid() {
  local param_name="$1"
  echo "denied: invalid ${param_name} for ${check}" >&2
  exit 1
}

valid_vmid() {
  [[ "$1" =~ ^[1-9][0-9]{2,8}$ ]]
}

valid_job_id() {
  [[ "$1" =~ ^[1-9][0-9]{2,8}-[0-9]{1,3}$ ]]
}

valid_upid() {
  [[ "$1" =~ ^UPID:[A-Za-z0-9._-]+:[0-9A-Fa-f]{8}:[0-9A-Fa-f]{8}:[0-9A-Fa-f]{8}:[A-Za-z0-9_-]+:[0-9]*:[A-Za-z0-9._-]+@[A-Za-z0-9._-]+:$ ]]
}

valid_storage() {
  [[ "$1" =~ ^[a-zA-Z][a-zA-Z0-9._-]{0,31}$ ]]
}

valid_limit() {
  [[ "$1" =~ ^[0-9]{1,4}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 2000 ))
}

run_remote() {
  local remote_command="$1"
  exec ssh -T \
      -F /dev/null \
      -i "$KEY" \
      -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile="$KNOWN" \
      -o ConnectTimeout=10 \
      -o BatchMode=yes \
      "recovery-exec@{{ target.host }}" "$remote_command"
}

# Backslash-continued with no indent on continuation lines so the pattern
# tokens carry no leading whitespace.
case "$check" in
  cluster-status|cluster-resources|ha-status|\
replication-status|replication-list|cluster-quorum|\
storage-status|zpool-health|zfs-list|\
journal-replication|journal-system|journal-cluster|\
users|unit-files|forced-command-keys)
    (( argc == 1 )) || deny_count
    run_remote "$check"
    ;;
  replication-read)
    (( argc == 2 )) || deny_count
    valid_job_id "$p1" || deny_invalid job-id
    run_remote "$check $p1"
    ;;
  vm-status|vm-config|zfs-list-vm|vm-conf-stat)
    (( argc == 2 )) || deny_count
    valid_vmid "$p1" || deny_invalid vmid
    run_remote "$check $p1"
    ;;
  vm-tasks)
    (( argc == 3 )) || deny_count
    valid_vmid "$p1" || deny_invalid vmid
    valid_limit "$p2" || deny_invalid limit
    run_remote "$check $p1 $p2"
    ;;
  task-log)
    (( argc == 2 )) || deny_count
    valid_upid "$p1" || deny_invalid UPID
    run_remote "$check $p1"
    ;;
  storage-status-one)
    (( argc == 2 )) || deny_count
    valid_storage "$p1" || deny_invalid storage
    run_remote "$check $p1"
    ;;
  journal-unit)
    (( argc == 3 )) || deny_count
    case "$p1" in
      pvescheduler|pvestatd|pve-cluster|corosync|pvedaemon) ;;
      *) deny_invalid unit ;;
    esac
    case "$p2" in
      30m|1h|2h|6h|12h|24h) ;;
      *) deny_invalid window ;;
    esac
    run_remote "$check $p1 $p2"
    ;;
  # --- Deployed artifact / unit introspection (Phase 3 catalog §3, P1/P2) ---
  # Enums mirror recovery-investigate-dispatch-pve.sh.j2 exactly. Codex and
  # Claude Code must reach the same checks (requirement R11) — the dispatch
  # being identical is not enough if this wrapper denies the check first.
  #
  # users / unit-files / forced-command-keys (catalog §6, D6, 2026-08-03) are
  # handled above in the no-operand list — same R11 reasoning as above.
  deployed-hash)
    (( argc == 2 )) || deny_count
    case "$p1" in
      investigate-dispatch-pve|authorized-keys) ;;
      *) deny_invalid name ;;
    esac
    run_remote "$check $p1"
    ;;
  unit-cat)
    (( argc == 2 )) || deny_count
    case "$p1" in
      pvescheduler|pvestatd|pve-cluster|corosync|pvedaemon) ;;
      *) deny_invalid unit ;;
    esac
    run_remote "$check $p1"
    ;;
  *)
    echo "denied: unknown check '${check:-}'" >&2
    exit 1
    ;;
esac
