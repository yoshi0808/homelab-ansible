#!/bin/bash
# homelab-investigate-{{ target.name }}: SSH investigation wrapper for {{ target.name }} (Proxmox node).
# Called by Codex: homelab-investigate-{{ target.name }} <check>
# Hostname is hardcoded (connection target fixed in script, not from args).
# -F /dev/null: skip system ssh_config (bwrap UID mapping breaks ownership checks).
#
# Read-only only: cluster-status / cluster-resources / ha-status. pve1/pve2
# have no recovery action wrappers (see AGENTS.md / autonomous_recovery_policy.md §4.6).
set -euo pipefail

KEY=/home/recovery-exec/.ssh/id_recovery_investigate_pve
KNOWN=/home/recovery-exec/.ssh/known_hosts

# Allowlist mirrors the dispatch script on {{ target.name }}.
case "${1:-}" in
  cluster-status|cluster-resources|ha-status)
    exec ssh -T \
        -F /dev/null \
        -i "$KEY" \
        -o StrictHostKeyChecking=yes \
        -o UserKnownHostsFile="$KNOWN" \
        -o ConnectTimeout=10 \
        -o BatchMode=yes \
        "recovery-exec@{{ target.host }}" "$1"
    ;;
  *)
    echo "denied: unknown check '${1:-}'" >&2
    exit 1
    ;;
esac
