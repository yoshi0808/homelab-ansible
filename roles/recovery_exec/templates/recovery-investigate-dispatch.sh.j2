#!/bin/bash
# recovery-investigate-dispatch.sh — deployed on {{ target_item.name }}
# Called via SSH forced command from recovery-exec@{{ inventory_hostname }}.
# Validates SSH_ORIGINAL_COMMAND against an allowlist, then executes it.
# No arguments accepted from the SSH client beyond the forced command key.
#
# Most checks below are single, literal, no-argument tokens matched against
# the full command string (unchanged behaviour). Loki横断ログ調査
# (loki-count / loki-window / loki-errors, monnie-only — see AR-095〜AR-101)
# is one of several parameterized cases (see also journal-ssh, deployed-hash,
# unit-cat below); each independently re-parses and re-validates its
# operands here rather than trusting the quory-side wrapper (AR-097), and
# none eval's or otherwise shell-reinterprets SSH_ORIGINAL_COMMAND
# (AR-048/AR-088 discipline).
set -euo pipefail

cmd="${SSH_ORIGINAL_COMMAND:-status}"

if [[ "$cmd" == *$'\n'* || "$cmd" == *$'\r'* ]]; then
  echo "denied: command contains a line break" >&2
  exit 1
fi

case "$cmd" in
  # --- Service checks (systemctl status / journalctl) ---
{% for svc in target_item.investigate_services %}
  {{ svc }})
    systemctl status {{ svc }} --no-pager -l
    ;;
  journal-{{ svc }})
    journalctl -u {{ svc }} -n 100 --no-pager
    ;;
  journal-{{ svc }}-1h)
    journalctl -u {{ svc }} --since "-1 hour" -n 300 --no-pager
    ;;
  journal-{{ svc }}-24h)
    journalctl -u {{ svc }} --since "-1 day" -n 300 --no-pager
    ;;
  journal-{{ svc }}-err)
    journalctl -u {{ svc }} -p err --since "-1 day" -n 200 --no-pager
    ;;
  journal-{{ svc }}-warn)
    journalctl -u {{ svc }} -p warning --since "-1 day" -n 200 --no-pager
    ;;
{% endfor %}
  status)
{% for svc in target_item.investigate_services %}
    echo "=== {{ svc }} ==="
    systemctl status {{ svc }} --no-pager -l || true
{% endfor %}
    ;;

  # --- Common system checks ---
  failed)
    systemctl --failed --no-pager
    ;;
  disk)
    df -h
    ;;
  memory)
    free -h
    echo "--- OOM (last 20 kernel messages) ---"
    journalctl -k -n 20 --no-pager | grep -i 'oom\|out of memory' || echo 'no OOM entries'
    ;;
  load)
    uptime
    ;;
  network)
    ip addr
    echo "---"
    ip route
    echo "---"
    resolvectl status 2>/dev/null || cat /etc/resolv.conf
    ;;
  ports)
    ss -ltnup
    ;;
  journal-system)
    journalctl -p warning..err -n 50 --no-pager
    ;;
  dmesg)
    # dmesg(1) requires CAP_SYSLOG on this host (kernel.dmesg_restrict=1) and
    # recovery-exec has no sudo for it; journalctl -k reads the same kernel
    # ring buffer via journald, which recovery-exec can already read as a
    # member of the systemd-journal group (no new privilege needed).
    journalctl -k -n 50 --no-pager
    ;;

  # --- journal-ssh (catalog §7, D7, 2026-08-03) ---
  # The SSH transport is what every other check here rides on, and until now
  # it was the one thing this dispatch could not look at. Three unit selectors,
  # all literals in this file:
  #   ssh.service  — the real unit ('sshd.service' is only an alias)
  #   ssh.socket   — enabled on this host, so socket-level refusals land here
  #   sshd@*       — per-connection sessions under socket activation
  # Querying only one of the three returns an empty result that proves nothing.
  # The single operand is the window, on the same enum the other classes use.
  journal-ssh|journal-ssh\ *)
    read -r _ window extra <<<"$cmd"
    if [[ -z "$window" || -n "$extra" ]]; then
      echo "denied: invalid parameter count for 'journal-ssh'" >&2
      exit 1
    fi
    case "$window" in
      30m) since_value="-30 min" ;;
      1h) since_value="-1 hours" ;;
      2h) since_value="-2 hours" ;;
      6h) since_value="-6 hours" ;;
      12h) since_value="-12 hours" ;;
      24h) since_value="-24 hours" ;;
      *)
        echo "denied: invalid window for 'journal-ssh'" >&2
        exit 1
        ;;
    esac
    journalctl -u ssh.service -u ssh.socket -u 'sshd@*' \
      --since "$since_value" -n 300 --no-pager
    ;;

  # --- Deployed artifact / unit introspection (Phase 3 catalog §2, G1/G2) ---
  deployed-hash|deployed-hash\ *)
    read -r _ name extra <<<"$cmd"
    if [[ -z "$name" || -n "$extra" ]]; then
      echo "denied: invalid parameter count for 'deployed-hash'" >&2
      exit 1
    fi
    case "$name" in
      recovery-push)
        target_path=/usr/local/sbin/recovery-push.sh
        ;;
      recovery-trigger-unit)
        target_path=/etc/systemd/system/recovery-trigger@.service
        ;;
      investigate-dispatch)
        target_path=/usr/local/sbin/recovery-investigate-dispatch.sh
        ;;
      action-script)
        target_path=/usr/local/sbin/recovery-action.sh
        ;;
      authorized-keys)
        target_path=/home/recovery-exec/.ssh/authorized_keys
        ;;
{% if 'loki' in target_item.investigate_services %}
      loki-helper)
        target_path=/usr/local/sbin/recovery-loki-helper
        ;;
{% endif %}
      *)
        echo "denied: invalid name for deployed-hash" >&2
        exit 1
        ;;
    esac
    sha256sum -- "$target_path"
    ;;
  unit-cat|unit-cat\ *)
    read -r _ unit extra <<<"$cmd"
    if [[ -z "$unit" || -n "$extra" ]]; then
      echo "denied: invalid parameter count for 'unit-cat'" >&2
      exit 1
    fi
    case "$unit" in
{% for svc in target_item.investigate_services %}
      {{ svc }}) ;;
{% endfor %}
      recovery-trigger@.service) ;;
      *)
        echo "denied: invalid unit for unit-cat" >&2
        exit 1
        ;;
    esac
    systemctl cat "$unit"
    ;;

  # --- catalog §6 additions (D6, 2026-08-03): X2-X4, shared contract with
  # classes Q/P. No new write vocabulary — only getent / systemctl
  # list-unit-files / this identity's own authorized_keys, all read. ---
  users)
    # uid bounds are fixed script constants (catalog §6.2 X2) — there is no
    # operand to take them from. /etc/shadow is never touched.
    while IFS=: read -r u_name _ u_uid _ _ _ u_shell; do
      if (( u_uid >= 1000 && u_uid <= 64999 )); then
        echo "${u_name}:${u_uid}:${u_shell}"
      fi
    done < <(getent passwd)
    ;;
  unit-files)
    systemctl list-unit-files --no-pager
    ;;
  forced-command-keys)
    # Self only: recovery-exec's own authorized_keys (catalog §6.2 X4 —
    # never another identity's file). Key material (key type + base64 blob)
    # is never printed, only the forced command path and comment field.
    entry_count=0
    while IFS= read -r keyline; do
      [[ -z "$keyline" || "$keyline" == \#* ]] && continue
      entry_count=$((entry_count + 1))
      read -r opts _ _ comment <<<"$keyline"
      if [[ "$opts" =~ command=\"([^\"]*)\" ]]; then
        cmd_path="${BASH_REMATCH[1]}"
      else
        cmd_path="(none)"
      fi
      echo "${entry_count}: command=${cmd_path} comment=${comment:-(none)}"
    done < /home/recovery-exec/.ssh/authorized_keys
    echo "total: ${entry_count} entries"
    ;;

  # --- Node-specific checks ---
{% for extra in target_item.investigate_extra | default([]) %}
  {{ extra.name }})
    {{ extra.cmd }}
    ;;
{% endfor %}
{% if 'loki' in target_item.investigate_services %}

  # --- Loki横断ログ調査 (AR-095〜AR-101, monnie-only) ---
  # Fixed arity: loki-count takes exactly 2 operands, loki-window exactly 4,
  # loki-errors exactly 2. `read` captures any operand beyond the declared
  # count into `extra`, so a 3rd/5th+ token is rejected before the helper is
  # ever invoked.
  loki-count|loki-count\ *)
    read -r _ since window extra <<<"$cmd"
    if [[ -z "$since" || -z "$window" || -n "$extra" ]]; then
      echo "denied: invalid parameter count for 'loki-count'" >&2
      exit 1
    fi
    if [[ ! "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$ ]]; then
      echo "denied: invalid since for loki-count" >&2
      exit 1
    fi
    case "$window" in
      5m|10m|15m|30m|1h|3h|6h|12h|24h) ;;
      *)
        echo "denied: invalid window for loki-count" >&2
        exit 1
        ;;
    esac
    exec /usr/local/sbin/recovery-loki-helper count "$since" "$window"
    ;;
  loki-window|loki-window\ *)
    read -r _ job since window level extra <<<"$cmd"
    if [[ -z "$job" || -z "$since" || -z "$window" || -z "$level" || -n "$extra" ]]; then
      echo "denied: invalid parameter count for 'loki-window'" >&2
      exit 1
    fi
    case "$job" in
      unifi|network-devices|pve-nodes|sophos-fw|ubuntu-nodes) ;;
      *)
        echo "denied: invalid job for loki-window" >&2
        exit 1
        ;;
    esac
    if [[ ! "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$ ]]; then
      echo "denied: invalid since for loki-window" >&2
      exit 1
    fi
    case "$window" in
      5m|10m|15m|30m|1h) ;;
      *)
        echo "denied: invalid window for loki-window" >&2
        exit 1
        ;;
    esac
    case "$level" in
      any|error|warning|info) ;;
      *)
        echo "denied: invalid level for loki-window" >&2
        exit 1
        ;;
    esac
    exec /usr/local/sbin/recovery-loki-helper window "$job" "$since" "$window" "$level"
    ;;
  loki-errors|loki-errors\ *)
    read -r _ since window extra <<<"$cmd"
    if [[ -z "$since" || -z "$window" || -n "$extra" ]]; then
      echo "denied: invalid parameter count for 'loki-errors'" >&2
      exit 1
    fi
    if [[ ! "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$ ]]; then
      echo "denied: invalid since for loki-errors" >&2
      exit 1
    fi
    case "$window" in
      1h|6h|12h|24h) ;;
      *)
        echo "denied: invalid window for loki-errors" >&2
        exit 1
        ;;
    esac
    exec /usr/local/sbin/recovery-loki-helper errors "$since" "$window"
    ;;
{% endif %}

  *)
    echo "denied: unknown command '${cmd}'" >&2
    exit 1
    ;;
esac
