#!/bin/bash
# recovery-investigate-dispatch.sh — deployed on {{ target_item.name }}
# Called via SSH forced command from recovery-exec@{{ inventory_hostname }}.
# Validates SSH_ORIGINAL_COMMAND against an allowlist, then executes it.
# No arguments accepted from the SSH client beyond the forced command key.
#
# Most checks below are single, literal, no-argument tokens matched against
# the full command string (unchanged behaviour). Loki横断ログ調査
# (loki-count / loki-window, monnie-only — see AR-095〜AR-101) is the only
# parameterized case; it independently re-parses and re-validates its
# operands here rather than trusting the quory-side wrapper (AR-097), and
# never eval's or otherwise shell-reinterprets SSH_ORIGINAL_COMMAND
# (AR-048/AR-088 discipline).
set -euo pipefail

cmd="${SSH_ORIGINAL_COMMAND:-status}"

if [[ "$cmd" == *$'\n'* || "$cmd" == *$'\r'* ]]; then
  echo "denied: command contains a line break" >&2
  exit 1
fi

case "$cmd" in
  # --- Service checks (systemctl status / journalctl) ---
{% for svc in target_item.investigate_services %}
  {{ svc }})
    systemctl status {{ svc }} --no-pager -l
    ;;
  journal-{{ svc }})
    journalctl -u {{ svc }} -n 100 --no-pager
    ;;
  journal-{{ svc }}-1h)
    journalctl -u {{ svc }} --since "-1 hour" -n 300 --no-pager
    ;;
  journal-{{ svc }}-24h)
    journalctl -u {{ svc }} --since "-1 day" -n 300 --no-pager
    ;;
  journal-{{ svc }}-err)
    journalctl -u {{ svc }} -p err --since "-1 day" -n 200 --no-pager
    ;;
  journal-{{ svc }}-warn)
    journalctl -u {{ svc }} -p warning --since "-1 day" -n 200 --no-pager
    ;;
{% endfor %}
  status)
{% for svc in target_item.investigate_services %}
    echo "=== {{ svc }} ==="
    systemctl status {{ svc }} --no-pager -l || true
{% endfor %}
    ;;

  # --- Common system checks ---
  failed)
    systemctl --failed --no-pager
    ;;
  disk)
    df -h
    ;;
  memory)
    free -h
    echo "--- OOM (last 20 kernel messages) ---"
    journalctl -k -n 20 --no-pager | grep -i 'oom\|out of memory' || echo 'no OOM entries'
    ;;
  load)
    uptime
    ;;
  network)
    ip addr
    echo "---"
    ip route
    echo "---"
    resolvectl status 2>/dev/null || cat /etc/resolv.conf
    ;;
  ports)
    ss -ltnup
    ;;
  journal-system)
    journalctl -p warning..err -n 50 --no-pager
    ;;
  dmesg)
    # dmesg(1) requires CAP_SYSLOG on this host (kernel.dmesg_restrict=1) and
    # recovery-exec has no sudo for it; journalctl -k reads the same kernel
    # ring buffer via journald, which recovery-exec can already read as a
    # member of the systemd-journal group (no new privilege needed).
    journalctl -k -n 50 --no-pager
    ;;

  # --- Node-specific checks ---
{% for extra in target_item.investigate_extra | default([]) %}
  {{ extra.name }})
    {{ extra.cmd }}
    ;;
{% endfor %}
{% if 'loki' in target_item.investigate_services %}

  # --- Loki横断ログ調査 (AR-095〜AR-101, monnie-only) ---
  # Fixed arity: loki-count takes exactly 2 operands, loki-window exactly 4.
  # `read` captures any operand beyond the declared count into `extra`, so a
  # 3rd/5th+ token is rejected before the helper is ever invoked.
  loki-count|loki-count\ *)
    read -r _ since window extra <<<"$cmd"
    if [[ -z "$since" || -z "$window" || -n "$extra" ]]; then
      echo "denied: invalid parameter count for 'loki-count'" >&2
      exit 1
    fi
    if [[ ! "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$ ]]; then
      echo "denied: invalid since for loki-count" >&2
      exit 1
    fi
    case "$window" in
      5m|10m|15m|30m|1h|3h|6h|12h|24h) ;;
      *)
        echo "denied: invalid window for loki-count" >&2
        exit 1
        ;;
    esac
    exec /usr/local/sbin/recovery-loki-helper count "$since" "$window"
    ;;
  loki-window|loki-window\ *)
    read -r _ job since window level extra <<<"$cmd"
    if [[ -z "$job" || -z "$since" || -z "$window" || -z "$level" || -n "$extra" ]]; then
      echo "denied: invalid parameter count for 'loki-window'" >&2
      exit 1
    fi
    case "$job" in
      unifi|network-devices|pve-nodes|sophos-fw|ubuntu-nodes) ;;
      *)
        echo "denied: invalid job for loki-window" >&2
        exit 1
        ;;
    esac
    if [[ ! "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$ ]]; then
      echo "denied: invalid since for loki-window" >&2
      exit 1
    fi
    case "$window" in
      5m|10m|15m|30m|1h) ;;
      *)
        echo "denied: invalid window for loki-window" >&2
        exit 1
        ;;
    esac
    case "$level" in
      any|error|warning|info) ;;
      *)
        echo "denied: invalid level for loki-window" >&2
        exit 1
        ;;
    esac
    exec /usr/local/sbin/recovery-loki-helper window "$job" "$since" "$window" "$level"
    ;;
{% endif %}

  *)
    echo "denied: unknown command '${cmd}'" >&2
    exit 1
    ;;
esac
