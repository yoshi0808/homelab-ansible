model = "{{ recovery_exec_codex_model }}"
approval_policy = "never"

# Sandbox: allow network (for SSH wrappers to reach targets).
# /var/lib/recovery-exec is in ReadWritePaths (recovery-io.service.j2) so bwrap
# can bind-mount it writable; workdir (--cd $WORKSPACE, under that path) is a
# writable root by default under workspace-write, so no explicit entry was
# needed for it. The mute dir is NOT the workdir, so it needs an explicit
# writable_roots entry here (Codex's own bwrap sandbox layer) — confirmed as
# the "SandboxWorkspaceWrite.writable_roots" field via `codex --strict-config
# doctor` accepting this config with no unrecognized-field error, codex-cli
# 0.144.1 (test_result 2026-07-14_012 T1).
[sandbox_workspace_write]
network_access = true
writable_roots = ["/var/lib/homelab-recovery/mute"]

# There is deliberately NO command allow-list in this file.
#
# An `[execpolicy]` table used to live here, listing the homelab-* wrappers as
# the only permitted commands. It never did anything: config.toml has no such
# key in codex-cli. Execpolicy is configured with Starlark `.rules` files
# (`codex execpolicy check --rules ...`, `codex exec --ignore-rules`), and even
# there an allow-list is not expressible — rules only classify commands they
# name (allow / prompt / forbidden), no catch-all pattern exists, and an
# unmatched command comes back with no decision at all, i.e. it runs. Measured
# 2026-07-31 on codex-cli 0.145.0.
#
# The boundaries that actually hold for this path: the workspace-write sandbox
# above, no_new_privileges (blocks sudo unconditionally), the SSH forced
# commands on each target, and the sudoers rule limiting who may invoke
# codex-exec-wrapper. Do not design a new capability on the assumption that
# anything here narrows the set of local commands the model can run.
#
# Incident: docs/ai/memory/incidents/2026-07-31_codex-execpolicy-allowlist-not-enforcing.md
