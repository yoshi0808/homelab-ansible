model = "{{ recovery_exec_codex_model }}"
approval_policy = "never"

# Sandbox: allow network (for SSH wrappers to reach targets).
# /var/lib/recovery-exec is in ReadWritePaths (recovery-io.service.j2) so bwrap
# can bind-mount it writable; workdir (--cd $WORKSPACE, under that path) is a
# writable root by default under workspace-write, so no explicit entry was
# needed for it. The mute dir is NOT the workdir, so it needs an explicit
# writable_roots entry here (Codex's own bwrap sandbox layer) — confirmed as
# the "SandboxWorkspaceWrite.writable_roots" field via `codex --strict-config
# doctor` accepting this config with no unrecognized-field error, codex-cli
# 0.144.1 (test_result 2026-07-14_012 T1).
[sandbox_workspace_write]
network_access = true
writable_roots = ["/var/lib/homelab-recovery/mute"]

# Execpolicy: intended as defense-in-depth (deny all, allow only the homelab-*
# wrappers, §5.3).
#
# MEASURED 2026-07-31 (codex-cli 0.145.0): this table does NOT block command
# execution. With this exact configuration, `id` — absent from the allow-list
# below — ran successfully under `codex exec` with approval_policy="never".
# DO NOT COUNT THIS AS A SECURITY BOUNDARY, and do not design a new capability
# on the assumption that it narrows what the model can run.
#
# The layers that do hold: the workspace-write sandbox, no_new_privileges
# (blocks sudo unconditionally), the SSH forced commands on each target, and
# the sudoers rule limiting who may invoke codex-exec-wrapper at all.
#
# The table is kept rather than deleted because the incident is still open and
# the `.rules` file mechanism this codex version documents (`--ignore-rules`)
# has not been evaluated. Removing it now would lose the record of intent.
# Incident: docs/ai/memory/incidents/2026-07-31_codex-execpolicy-allowlist-not-enforcing.md
[execpolicy]
default_policy = "deny"

# --- Investigation (read-only) ---
{% for target in recovery_exec_targets %}
[[execpolicy.rules]]
command = "homelab-investigate-{{ target.name }}"
policy = "allow"

{% endfor %}
{% for target in recovery_exec_pve_targets %}
[[execpolicy.rules]]
command = "homelab-investigate-{{ target.name }}"
policy = "allow"

{% endfor %}
[[execpolicy.rules]]
command = "homelab-reports"
policy = "allow"

[[execpolicy.rules]]
command = "homelab-semaphore-query"
policy = "allow"

# --- Recovery (service restart) ---
{% for target in recovery_exec_targets %}
[[execpolicy.rules]]
command = "homelab-recover-{{ target.name }}"
policy = "allow"

{% endfor %}
# --- Monitoring control ---
[[execpolicy.rules]]
command = "homelab-monitoring-pause"
policy = "allow"

[[execpolicy.rules]]
command = "homelab-monitoring-resume"
policy = "allow"

[[execpolicy.rules]]
command = "homelab-monitoring-status"
policy = "allow"

# --- Per-target mute (TTL付き, sudo無し; §7 / requirement 2026-07-14) ---
[[execpolicy.rules]]
command = "homelab-mute-set"
policy = "allow"

[[execpolicy.rules]]
command = "homelab-mute-status"
policy = "allow"

[[execpolicy.rules]]
command = "homelab-mute-clear"
policy = "allow"
