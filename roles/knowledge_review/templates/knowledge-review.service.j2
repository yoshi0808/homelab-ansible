[Unit]
Description=Monthly knowledge review (classification and promotion)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ knowledge_review_run_user }}
WorkingDirectory={{ knowledge_review_repo_dir }}
# 2026-08-03(Yoshinobu決定): claude -p の起動2本を廃止した。ここで走るのは
# quoryへのdispatch(SSH、コネクト{{ knowledge_review_incident_dispatch_connect_timeout_s }}秒+呼び出し
# {{ knowledge_review_incident_dispatch_timeout_s }}秒を最大2往復)とファイル書き込み・Slack送信のみで、
# 既定90秒の TimeoutStartSec でも収まる規模だが、quory側の遅延・再送を
# 吸収する余裕として明示的に伸ばしておく。
TimeoutStartSec=300
ExecStart=/usr/bin/flock -n /run/lock/ansible-knowledge-review.lock {{ knowledge_review_playbook_bin }} playbooks/knowledge_review.yml
