prefix_rule(pattern=["git", "commit"], decision="prompt")
prefix_rule(pattern=["git", "push"], decision="prompt")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", ["restore", "checkout", "switch", "stash", "reset", "clean"]], decision="prompt")
prefix_rule(pattern=["scripts/safe-ansible-check.sh"], decision="allow")
prefix_rule(pattern=["ansible-playbook"], decision="allow")

prefix_rule(pattern=["ssh"], decision="prompt", justification="SSH connects to an external host and should be confirmed")
prefix_rule(pattern=["rm"], decision="prompt", justification="File removal should be confirmed")
prefix_rule(pattern=["stat", "-c"], decision="allow")
prefix_rule(pattern=["cmp", "-s"], decision="allow")

prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["readlink"], decision="allow")
prefix_rule(pattern=["realpath"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["sha256sum"], decision="allow")

prefix_rule(pattern=["systemctl", "is-active"], decision="allow")
prefix_rule(pattern=["systemctl", "is-enabled"], decision="allow")
prefix_rule(pattern=["systemctl", "is-failed"], decision="allow")
prefix_rule(pattern=["systemctl", "status"], decision="allow")
prefix_rule(pattern=["systemctl", "show"], decision="allow")
prefix_rule(pattern=["systemctl", "cat"], decision="allow")
prefix_rule(pattern=["systemctl", "--failed"], decision="allow")
prefix_rule(pattern=["systemctl", "list-units"], decision="allow")
prefix_rule(pattern=["systemctl", "list-unit-files"], decision="allow")

prefix_rule(pattern=["ss"], decision="allow")
prefix_rule(pattern=["uptime"], decision="allow")
prefix_rule(pattern=["chronyc", "tracking"], decision="allow")
prefix_rule(pattern=["chronyc", "sources"], decision="allow")
prefix_rule(pattern=["chronyc", "sourcestats"], decision="allow")
prefix_rule(pattern=["chronyc", "waitsync"], decision="allow")
prefix_rule(pattern=["apt", "list", "--upgradable"], decision="allow")
prefix_rule(pattern=["dpkg-query", "-W"], decision="allow")

prefix_rule(pattern=["sleep", "2"], decision="allow")
prefix_rule(pattern=["tmux", "capture-pane", "-p", "-t", "%5", "-S", "-30"], decision="allow")
prefix_rule(pattern=["tmux", "capture-pane", "-p", "-t", "%5", "-S", "-35"], decision="allow")

# Yoshinobu: tmux operations do not require confirmation (2026-09-06).
prefix_rule(pattern=["tmux"], decision="allow")

# Read-only Operator Request Channel retrieval. `submit` is intentionally not
# included: it appends an irreversible request to the production-side spool.
prefix_rule(pattern=["operator-channel-client", ["list", "get", "status"]], decision="allow")
