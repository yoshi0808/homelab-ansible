{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_ansible_guard.sh\"",
            "statusMessage": "Checking Ansible command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_ansible_guard.sh\"",
            "statusMessage": "Checking Ansible approval request"
          }
        ]
      }
    ]
  }
}
