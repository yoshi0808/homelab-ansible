        "defaults": {
          "custom": {
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "min": 0,
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "pluginVersion": "",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "ffn86ietu7jeoc"
          },
          "expr": "sum by(host) (count_over_time({job=~\"pve-nodes|sophos-fw|ubuntu-nodes|unifi\", host=~\"$host\", level=~\"$level\"} |= \"$search\" [$__interval]))",
          "legendFormat": "{{host}}",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "ffn86ietu7jeoc"
          },
          "expr": "sum by(host) (count_over_time({job=\"network-devices\", host=~\"$host\"} |= \"$search\" [$__interval]))",
          "legendFormat": "{{host}}",
          "queryType": "range",
          "refId": "B"
        }
      ],
